{
  "name": "beui-vue",
  "version": "0.1.0-alpha.1",
  "description": "Animated Vue 3 components and UI blocks, the Vue port of beUI. motion-v, TypeScript, Nuxt SSR, shadcn-vue registry.",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "vue-components",
    "animation",
    "motion",
    "motion-v",
    "ui",
    "ui-components",
    "component-library",
    "shadcn-vue",
    "typescript",
    "ai-chat",
    "charts",
    "beui"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stickerwu/beui-vue.git",
    "directory": "vue/packages/ui"
  },
  "homepage": "https://beui.stickerwu.net/",
  "bugs": {
    "url": "https://github.com/stickerwu/beui-vue/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.76",
    "@vueuse/core": "^14.0.0",
    "lenis": "1.3.23",
    "motion-v": "2.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/package-assets.mjs"
  }
}
