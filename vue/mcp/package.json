    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "~5.9.3",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
